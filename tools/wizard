        _check(rows, "Wizard shell answers", code == 200 and isinstance(health, dict), base)
        _check(rows, "shell reaches this Hermes", bool((health or {}).get("upstream_reachable")),
               "upstream_reachable" if (health or {}).get("upstream_reachable") else "shell can't reach Hermes")
    except Exception as e:  # noqa: BLE001
        _check(rows, "Wizard shell answers", False, f"{base}: {str(e)[:100]}")
    # one live request through the bridge: wizard_apps on the gateway, with the token Hermes uses
    live = None
    if token:
        try:
            gw = MCP({"id": "wizard", "mcp": {"url": url}}, "url", 20)
            gw.token = token
            gw.open()
            names = [t.get("name") for t in gw.tools()]
            res = gw.request("tools/call", {"name": "wizard_apps", "arguments": {}})
            gw.close()
            text = "".join(c.get("text", "") for c in res.get("content") or [] if isinstance(c, dict))
            live = {"tools": len(names), "app_tools": [n for n in names if "__" in n][:12]}
            _check(rows, "live request through the bridge (wizard_apps)", not res.get("isError") and bool(text),
                   f"{len(names)} tools on the gateway")
        except Fail as e:
            _check(rows, "live request through the bridge (wizard_apps)", False, e.message[:160])
    else:
        _check(rows, "live request through the bridge (wizard_apps)", False, "no gateway token")
    gate = None
    if ns.gate:
        gate = run_gate_request(home, ns)
        _check(rows, "gate request (Hermes picks the app tool first)", gate.get("pass", False),
               f"{gate.get('prompt')!r} -> {gate.get('first') or 'no app call'}")
    return {"ok": all(r["ok"] for r in rows), "checks": rows, "gateway": url, "live": live, "gate": gate}


def run_gate_request(home: Path, ns) -> dict:
    """One weak-model gate request (spec/AGENT_BRIDGE.md, Proof): a fresh Hermes chat with a job-worded request;
    pass when the first app-relevant tool call is the expected <app>__<tool>. Only tool names are kept."""
    import subprocess
    reg = {}
    try:
        reg = load_registry(registry_path(None))
    except Fail:
        pass
    ids = {a.get("id") for a in reg.get("apps") or []}
    if "hello-wizard" in ids:
        prompt, want = "what time is it on my server?", "hello_wizard__wizard_time"
    else:
        prompt, want = "what apps do I have installed?", "wizard_apps"
    neutral = {"skill_view", "skills_list", "tool_search", "tool_describe", "todo", "todo_list", "memory"}
    cmd = [hermes_bin(), "chat", "-q", prompt, "--format", "stream-json", "--yolo", "--max-turns", "6"]
    if ns.model:
        cmd += ["-m", ns.model]
    if ns.provider:
        cmd += ["--provider", ns.provider]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL,
                             env={**os.environ, "HERMES_HOME": str(home)}).stdout
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
    calls = []
    for line in out.splitlines():
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") != "tool_use":
            continue
        name, args = str(ev.get("name") or ""), ev.get("input") if isinstance(ev.get("input"), dict) else {}
        inner = [str(c.get("name") or "") for c in (args.get("calls") or [args])] if name == "tool_call" else [name]
        calls += [n.split(f"mcp__{MCP_NAME}__", 1)[-1] for n in inner]
    first = next((c for c in calls if c and c not in neutral), None)
    return {"prompt": prompt, "expected": want, "first": first, "calls": calls[:8], "pass": first == want}


# ------------------------------------------------------------------ hermes status / hermes update --stable
#
# docs/HERMES_STABLE.md step 4 (DECISIONS #74). An alongside box runs the owner's own source-installed Hermes. This
# moves it to the exact Hermes release Wizard stable pins (the `hermes` block of the release file named by
# releases/stable), never to `main` and never through plain `hermes update`. Order: read the pin, check the install
# (git checkout, clean, the tag still resolves to the pinned commit, no downgrade), wait for a quiet moment with the
# gateway draining, back up the Hermes home, move the checkout and its venv to the pinned commit, restart the gateway,
# run the stable checks. Any failure after the first change puts the previous commit, its dependencies and every
# changed file back, restarts and re-checks. Everything lands in a 0600 receipt under $WIZARD_OS_HOME/hermes-update/.

RELEASE_BASE = "https://raw.githubusercontent.com/humanitylabs-org/wizard-app-manager/main/releases"
UPDATE_DIR = "hermes-update"
NOT_FINAL_TAG = re.compile(r"(^|[.-])(rc|canary|abandoned|alpha|beta|dev)([.\d-]|$)|\+|^(stable|latest|main|nightly)$",
                           re.I)
SHA40 = re.compile(r"^[0-9a-f]{40}$")
BACKUP_FILES = ("config.yaml", ".env", "auth.json", "SOUL.md", "cron/jobs.json")
BACKUP_DIRS = ("skills", "memories")
CHECK_PROMPT = "This is an automatic Wizard OS check after a Hermes update. Reply with the single word: READY"
EXIT.update({"update_refused": 10, "update_by_hand": 10, "not_quiet": 11, "update_rolled_back": 12,
             "rollback_failed": 13})


def _now() -> str:
    import time as _t
    return _t.strftime("%Y-%m-%dT%H:%M:%SZ", _t.gmtime())


def _read_source(src: str, timeout: float) -> str:
    if re.match(r"^https?://", src):
        req = urllib.request.Request(src, headers={"Cache-Control": "no-cache", "User-Agent": f"wizard/{VERSION}"})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read().decode("utf-8")
        except urllib.error.HTTPError as e:
            raise Fail("unreachable", f"{src} answered HTTP {e.code}") from None
        except (urllib.error.URLError, OSError) as e:
            raise Fail("unreachable", f"could not read {src}: {_why(e)}") from None
    try:
        return Path(src).expanduser().read_text(encoding="utf-8")
    except OSError as e:
        raise Fail("usage", f"could not read {src}: {_why(e)}") from None


def stable_pin(ns) -> dict:
    """The Hermes pin of the release this command follows: --release <version|file|URL>, else releases/stable."""
    base = (os.environ.get("WIZARD_RELEASE_BASE") or RELEASE_BASE).rstrip("/")
    src = ns.release
    if not src:
        version = _read_source(f"{base}/stable", ns.timeout).strip()
        if not re.fullmatch(r"[0-9A-Za-z.\-]+", version or ""):
            raise Fail("protocol_error", f"{base}/stable does not name a release")
        src = f"{base}/{version}.json"
    elif not (re.match(r"^https?://", src) or src.endswith(".json") or Path(src).expanduser().exists()):
        src = f"{base}/{src}.json"
    try:
        doc = json.loads(_read_source(src, ns.timeout))
    except json.JSONDecodeError:
        raise Fail("protocol_error", f"{src} is not JSON") from None
    h = doc.get("hermes") if isinstance(doc, dict) else None
    if not isinstance(h, dict):
        raise Fail("update_refused", f"release {doc.get('version') if isinstance(doc, dict) else '?'} ({src}) pins no "
                   "Hermes (`hermes` block missing; required from 0.3.23)")
    tag, commit = str(h.get("tag") or ""), str(h.get("commit") or "")
    if not tag or NOT_FINAL_TAG.search(tag.lstrip("v")) or NOT_FINAL_TAG.search(tag):
        raise Fail("update_refused", f"the pinned Hermes tag {tag!r} is not a final release tag")
    if not SHA40.fullmatch(commit):
        raise Fail("update_refused", f"the pinned Hermes commit {commit!r} is not a full 40-character commit")
    image = h.get("image") if isinstance(h.get("image"), dict) else {}
    return {"release": doc.get("version"), "source": src, "tag": tag, "commit": commit,
            "image_digest": image.get("digest"), "test_record": h.get("test_record"), "rollback": h.get("rollback")}


def _run(args: list, cwd=None, env=None, timeout: int = 900, check: bool = True):
    import subprocess
    p = subprocess.run([str(a) for a in args], cwd=str(cwd) if cwd else None, env=env, capture_output=True, text=True,
                       timeout=timeout, stdin=subprocess.DEVNULL)
    if check and p.returncode != 0:
        tail = "\n".join((p.stderr or p.stdout or "").strip().splitlines()[-4:])
        raise RuntimeError(f"`{' '.join(str(a) for a in args[:4])}` exited {p.returncode}: {tail}")
    return p


def _git(repo: Path, *args: str, check: bool = True, timeout: int = 300) -> str:
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "LC_ALL": "C"}
    return (_run(["git", "-C", repo, *args], env=env, timeout=timeout, check=check).stdout or "").strip()


def hermes_install(home: Path) -> dict:
    """Where this Hermes's code and venv live. Only installer-style git checkouts with a venv are updated here."""
    exe = Path(hermes_bin())
    real = exe.resolve()
    venv = real.parent.parent if (real.parent.parent / "pyvenv.cfg").is_file() else None
    cands = [os.environ.get("WIZARD_HERMES_REPO"), venv.parent if venv else None, home / "hermes-agent"]
    repo = next((Path(c) for c in cands if c and (Path(c) / ".git").exists() and (Path(c) / "pyproject.toml").is_file()),
                None)
    if repo is None:
        raise Fail("update_by_hand", f"this Hermes ({exe}) is not a git checkout that Wizard OS can move; update it by "
                   "hand to the Wizard stable tag (`wizard hermes status` names it)")
    if venv is None and (repo / "venv" / "pyvenv.cfg").is_file():
        venv = repo / "venv"
    if venv is None:
        raise Fail("update_by_hand", f"no venv found for the Hermes checkout at {repo} (a managed runtime); update it "
                   "by hand to the Wizard stable tag")
    stamp = repo / "install-stamp.json"
    if stamp.is_file():
        try:
            mech = json.loads(stamp.read_text(encoding="utf-8")).get("updateMechanism")
        except (OSError, ValueError):
            mech = "unreadable"
        if mech not in (None, "self"):
            raise Fail("update_by_hand", f"{stamp} says updates belong to {mech!r}, not this checkout; left it alone")
    import shutil
    uv = os.environ.get("WIZARD_UV") or shutil.which("uv") or next(
        (str(p) for p in (Path.home() / ".local/bin/uv", home / "bin/uv", Path.home() / ".cargo/bin/uv") if p.is_file()),
        None)
    return {"hermes": str(exe), "repo": repo, "venv": venv, "python": venv / "bin" / "python", "uv": uv}


def _hermes_env_full(home: Path) -> dict:
    env = {k: v for k, v in os.environ.items() if k not in ("VIRTUAL_ENV", "PYTHONHOME", "PYTHONPATH")}
    env.update(HERMES_HOME=str(home), NO_COLOR="1")
    return env


