# host-hop settings. Copy to hosts.env next to the scripts and edit. Every script reads this file;
# nothing box-specific lives in the scripts. Bash syntax. No secrets here.
#
# Values below are placeholders (they also drive the fixture tests). The first real hop moved an
# Ubuntu VPS to a Debian 13 mini PC; afterwards the mini PC was <agent>-main and the VPS
# <agent>-backup-1 (fenced standby).

# Agent name. Role names derive from it: <agent>-main and <agent>-backup-<n>.
HOP_AGENT=wizard
HOP_USER=wizard
HOP_HOME=/home/wizard
HOP_TAILNET_SUFFIX=example-tailnet.ts.net

# Hosts known to the hop (keys). For each: ssh alias reachable from the other host, machine hostname
# (`hostname -s`), current tailnet node name and IP, and the backup index used when it is demoted.
# Source and target are always passed on the command line (FROM TO); nothing here says which is which.
# Host keys may contain '-'; per-host variable names use the key with '-' replaced by '_'.
HOP_HOSTS="source-host target-host"

HOP_SSH_source_host=source-host
HOP_MACHINE_source_host=source-host
HOP_TSNAME_source_host=source-host
HOP_TSIP_source_host=100.64.0.1
HOP_BACKUP_INDEX_source_host=1

HOP_SSH_target_host=target-host
HOP_MACHINE_target_host=target-host
HOP_TSNAME_target_host=target-host
HOP_TSIP_target_host=100.64.0.2
HOP_BACKUP_INDEX_target_host=1
# Optional: direct raw-IP key used by preflight (default $HOP_HOME/.ssh/<target-key>_ed25519).
# HOP_DIRECT_KEY_target_host=/home/wizard/.ssh/target-host_ed25519

# Rootless docker sub-id range (must match /etc/subuid and /etc/subgid on every host).
HOP_SUBID_START=100000
HOP_SUBID_COUNT=65536

# Paths (relative to $HOME) that belong to each machine and are never sent or deleted by sync.
# The first hop also listed /sniper/ /.android/ /.ssh/vps_vision_ed25519* and the sniper-* and
# wizard-home-relay units and config (machine-local jobs that stayed on the mini PC).
HOP_TARGET_OWNED="/.ssh/authorized_keys /.ssh/known_hosts /.ssh/known_hosts.old /.config/uv/ /.sudo_as_admin_successful"

# Units that belong to each machine (shell globs). Never frozen, stopped, moved or started by the hop,
# and their egress stays allowed in test mode. First hop: "sniper-* wizard-home-relay.service".
HOP_HOST_LOCAL_UNITS="example-local-scan.service example-local-relay.service"
# Exact unit names whose network egress stays open in test mode (default: HOP_HOST_LOCAL_UNITS; no globs here).
# HOP_TEST_EGRESS_EXEMPT="example-local-scan.service example-local-relay.service"

# Source-OS user units the target OS does not ship, waived by the promotion unit gate (lesson 6).
# First hop (Ubuntu -> Debian):
HOP_OS_ONLY_UNITS="session-migration.service pk-debconf-helper.socket launchpadlib-cache-clean.timer"

# Extra regenerable trees to skip (beyond the generic cache/venv/node_modules rules in sync.sh).
HOP_EXTRA_EXCLUDES="/snap/ /tmp/ /.bun/install/ /.local/share/pnpm/ /.hermes/cache/scratch/ /.hermes/cache/uv/ /.hermes/cache/web/ /.hermes/cache/generated/ /.hermes/cache/terminal-output/ /.hermes/cache/*.jsonl.gz /.config/google-chrome/ /.config/google-chrome-headless/ /.config/chromium/"

# Extra trees whose SQLite files are always treated as live (copied with sqlite3_rsync).
# Built-in: /.hermes/ /runtipi/ /.wizard-os/ /.config/ /.local/share/. First hop added /human_notes/.
HOP_SQLITE_HOT_ROOTS_EXTRA=""

# Disposable containers and units (lesson 3): skipped by inventory, sync and recovery. Extended regex on name.
HOP_CONTAINER_SKIP_REGEX='(^|[-_])(qa|test|apk|dev|candidate)([-_]|$)'
HOP_UNIT_SKIP_REGEX='(^|[-_])(qa|test|candidate)([-_.]|$)'

# Standalone (non-compose) containers that may be recreated on the target, as name=image.
HOP_STANDALONE_ALLOWED="wizard-local-registry=registry:2"

# Directories with package-lock.json whose node_modules are rebuilt on the target (npm ci).
HOP_NODE_REBUILD="/home/wizard/.hermes/hermes-agent"

# Units that must never run in test mode (in addition to every *.timer/*.path and anything sending/syncing out).
# The first hop also listed its backup, vault sync, morning-report sync and notification relays.
HOP_TEST_NEVER_UNITS="hermes-gateway.service cron-to-notifications.service wizard-guardian.service wizard-ux-sync.service wizard-workspace-sync.service wizard-browser-handoff.service"
# Runtipi app projects that never start in test mode (bridges to real accounts / real devices).
HOP_TEST_DENY_APPS="messenger smart-home"

# Live databases that need special handling (Runtipi's Postgres).
HOP_PG_CONTAINER=runtipi-db
HOP_PG_USER=tipi
HOP_PG_DB=tipi
HOP_PG_DATADIR=/runtipi/data/postgres

# System-level pieces outside $HOME (copied read-only, installed disabled on the standby, enabled on promote).
# Cloudflare tunnels are deliberately NOT here (see spec "Not covered yet").
# First hop: HOP_SYSTEM_UNITS="wizardos-path-gateway.service" HOP_SYSTEM_PATHS="/opt/wizardos-path-gateway"
HOP_SYSTEM_UNITS=""
HOP_SYSTEM_PATHS=""

# Python virtualenvs rebuilt on the target from a `uv pip freeze` of the source (never copied).
HOP_VENVS="/home/wizard/.hermes/hermes-agent/venv /home/wizard/.hermes/hermes-agent/.venv /home/wizard/.hermes/cron-venv"

# Container whose bind mounts translate compose label paths (/data/apps/...) to host paths. Empty = none.
HOP_COMPOSE_PATHMAP_CONTAINER=runtipi
# Compose project started first (core), and services of it to skip in test mode.
HOP_CORE_PROJECT=runtipi
HOP_TEST_CORE_SKIP_SERVICES="runtipi"
# Units allowed in test mode (everything else stays blocked by the standby guard).
HOP_TEST_UNITS="apps-manager.service wizard-app-manager-api.service wizard-store-data.service wizard-system-resources.service wizard-troubleshooter.service wizard-ui-prefs.service hermesui-launcher.service hermesui.service"
HOP_TEST_SYSTEM_UNITS=""

# Ports of the stack.
HOP_SHELL_PORT=8444
HOP_STATUS_PORT=8979
# Tailscale Serve ports that only exist for previews and are not restored on the new main.
HOP_SERVE_SKIP_PORTS_ON_TARGET=""
# Exact argv of the protected Wizard UI process (space-separated), checked before teardown TERMs it.
HOP_UI_CMDLINE="/usr/bin/python3.12 -I /home/wizard/github_repos/HermesUI-v0.2-live/hermesui/installer/managed-app.py 8797"

# Optional SSH forced-command fence. An authorized_keys entry on the source, used by the target (from its
# tailnet IP) to call a machine-local service, is swapped for forced-command-fence.sh while the hop drains,
# so calls fail cleanly instead of reaching a half-stopped source. Empty = no fence.
# Example: "/usr/bin/python3 -I $HOP_HOME/.local/share/<service>/gateway.py".
HOP_FENCE_FORCED_COMMAND=""

# Optional executable run on the new main at the end of `promote.sh activate` (machine-local fixups).
HOP_POST_ACTIVATE_HOOK=""

# Downtime estimate: fixed stop/start overhead in seconds on top of the measured final-sync time.
# The first hop measured 116.
HOP_STOP_START_OVERHEAD_SECONDS=120
