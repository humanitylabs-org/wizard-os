      "commit": "be8cdf1d489161321c472ef88e600fdca2a122b8",
      "branch": "main",
      "note": "specs + the generic `wizard` CLI (vendored byte-identical in wizard-app-manager/wizard-cli/, SOURCE.json pins it). A release file cannot name the commit that adds it, so this pins the commit before it."
    }
  },
  "images": {
