{
  "version": "0.2.1",
  "name": "WizardOS 0.2.1",
  "date": "2026-10-12",
  "about": "One WizardOS version: the commit of every component repo, the images those commits produced, and the default app in each parking spot. The installer (wizard-app-manager get.sh) installs these pins and reads back what runs. Check with: python3 tools/check_release.py releases/0.2.1.json",
  "install": {
    "command": "curl -fsSL aiwizards.com/os.sh | bash",
    "modes": {
      "fresh": "blank Ubuntu/Debian box: Runtipi + App Manager + the default app in every spot (including hermes-agent)",
      "alongside": "box that already runs Hermes (run as its owner): App Manager + apps + the Wizard shell pointed at that Hermes; `wizard link` connects it, `wizard unlink` reverses it byte for byte"
    }
  },
  "components": {
    "wizard-app-manager": {
      "repo": "humanitylabs-org/wizard-app-manager",
      "commit": "8aa07a44d146dd6d7f9dff7e85cbdf08cb38257d",
      "branch": "main",
      "note": "main after #12 (alongside mode, squash-merged as 8aa07a4). Replaces 0.2.0's pin of the pre-merge branch commit 46f63f2, which is not on main."
    },
    "wizard-agent-service": {
      "repo": "humanitylabs-org/wizard-agent-service",
      "commit": "f772b830ec4f3ba1faff885f8a66914b6010f062",
