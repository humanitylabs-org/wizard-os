      "architectures": [
        "amd64",
        "arm64"
      ],
      "note": "The image workflow only rebuilds when an image input changes (image.yml paths). Last build was 1eab0eb; #12 changed none of those files, so this digest is main's image. check_release proves both: provenance names 1eab0eb, and no image input changed from 1eab0eb to the pinned commit.",
      "source_commit": "1eab0eb991e4031f3fd992c9745f0f9d9f4bfd7a",
      "image_inputs": [
        "packages/**",
